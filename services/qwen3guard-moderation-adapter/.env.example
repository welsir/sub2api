# [INPUT]: Operator-selected bind address, external secrets, backend URL/model, and runtime bounds.
# [OUTPUT]: Example environment contract consumed by the standalone Qwen3Guard adapter.
# [POS]: Non-secret startup template for the Sub2API-owned standalone adapter package.
#
# [PROTOCOL]:
# 1. Update this header when the environment contract changes.
# 2. Keep all credentials as obvious placeholders and all backend addresses non-public.

QWEN3GUARD_ADAPTER_HOST=127.0.0.1
QWEN3GUARD_ADAPTER_PORT=8090
QWEN3GUARD_ADAPTER_BEARER_TOKEN=replace-with-a-dedicated-random-secret

# Base and readiness paths must not contain backslashes or dot segments.
QWEN3GUARD_BACKEND_BASE_URL=http://127.0.0.1:8101
QWEN3GUARD_BACKEND_MODEL=Qwen/Qwen3Guard-Gen-0.6B
QWEN3GUARD_BACKEND_BEARER_TOKEN=
QWEN3GUARD_BACKEND_READINESS_PATH=/health
QWEN3GUARD_MODEL_REVISION=pin-the-deployed-model-revision

QWEN3GUARD_ADAPTER_MAX_BODY_BYTES=262144
QWEN3GUARD_ADAPTER_MAX_INPUT_CHARS=32768
QWEN3GUARD_ADAPTER_MAX_CONCURRENCY=2
QWEN3GUARD_ADAPTER_MAX_QUEUE=8
QWEN3GUARD_ADAPTER_INFERENCE_TIMEOUT_MS=15000
QWEN3GUARD_ADAPTER_READINESS_TIMEOUT_MS=2000
QWEN3GUARD_ADAPTER_REQUEST_TIMEOUT_MS=10000
QWEN3GUARD_ADAPTER_HEADERS_TIMEOUT_MS=5000
QWEN3GUARD_ADAPTER_SHUTDOWN_TIMEOUT_MS=5000
